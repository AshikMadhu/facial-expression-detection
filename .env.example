# ==============================================================================
# EmotionSense AI: Environment Variables Configuration Template
# Copy this file to '.env' and modify settings for local development or deployment
# ==============================================================================

# Application Environment configuration [development | production | staging]
ENV=production

# Log outputs level [DEBUG | INFO | WARNING | ERROR]
LOG_LEVEL=INFO

# Streamlit Host Port Allocation (matches EXPOSE in Dockerfile)
PORT=8501
HOST=0.0.0.0

# Database Telemetry Paths
DATASET_CSV_PATH=data/fer2013.csv

# Saved Model Checkpoint Directory
MODEL_PATH=packages/ml-models/models/mobilenetv2_transfer

# Hardware & Accelerator Configurations
USE_MIXED_PRECISION=True
CUDA_VISIBLE_DEVICES=0  # Set to empty string "" to force CPU execution in Docker
